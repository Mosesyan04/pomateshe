# Copy to .env and fill in real values. Never commit .env — see docs/SECURITY.md §7.
#
# MUST be the exact same value as app/web's own AUTH_SECRET — this process verifies room
# tokens signed by app/web/src/lib/whiteboard/room-token.ts using this shared secret, and has
# no other way to check them (no Postgres credentials at all, docs/WHITEBOARD.md §2).
AUTH_SECRET="<same value as app/web's AUTH_SECRET>"

# Optional — defaults to 3101 if unset.
# PORT=3101

# Absolute path to the local-disk stand-in for the whiteboard snapshot bucket
# (docs/FILE_STORAGE.md §2/§3, docs/WHITEBOARD.md §4) — MUST be the exact same absolute path
# as app/web's own WHITEBOARD_SNAPSHOT_DIR (see that package's .env.example). This process is
# the only writer of snapshot objects; app/web only ever deletes them (retention cron). A real
# S3 bucket would have no such path-agreement constraint at all.
WHITEBOARD_SNAPSHOT_DIR="<same absolute path as app/web's WHITEBOARD_SNAPSHOT_DIR>"
