# Copy to .env and fill in real values. Never commit .env — see docs/SECURITY.md §7.
#
# Two separate Postgres roles by design (docs/MULTI_TENANCY.md §2.3): DATABASE_URL (migrator,
# owns the schema, used only by `prisma migrate` CLI commands) and APP_DATABASE_URL (runtime
# role, not a table owner, RLS actually applies to it). Never point the running app at
# DATABASE_URL — that would make it connect as the table owner and silently disable Row-Level
# Security.
DATABASE_URL="postgresql://pomateshe_migrator:<password>@<host>:5432/pomateshe?schema=public"
APP_DATABASE_URL="postgresql://pomateshe_app:<password>@<host>:5432/pomateshe?schema=public"

# Signs session tokens / password-reset tokens (docs/AUTH.md). Generate with
# `openssl rand -base64 32` or equivalent — never reuse across environments.
AUTH_SECRET="<random-secret>"

# The app's own absolute origin — used to build links meant to be copied/shared outside the
# app itself (public teacher page, student invite links) and, since docs/CALENDAR.md §2's
# Google OAuth flow, the fixed `redirect_uri` registered in Google Cloud Console. Must be
# exact (no trailing slash) — Google rejects a redirect_uri that doesn't match its allowlist
# byte-for-byte.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google Calendar OAuth (docs/CALENDAR.md) — create an OAuth 2.0 Client ID in Google Cloud
# Console (type "Web application"), and register NEXT_PUBLIC_APP_URL above +
# "/api/google-calendar/callback" as an authorized redirect URI. Until these are set, the
# "Подключить Google Calendar" button on /teacher/profile fails with a clear server error
# rather than a silent no-op — the calendar UI itself (docs/CALENDAR.md §7) works fully
# without them.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# AES-256-GCM key for encrypting Google Calendar OAuth tokens at rest (docs/SECURITY.md §7) —
# required together with the two GOOGLE_* vars above. Generate with `openssl rand -base64 32`;
# rotating it invalidates every stored integration (all teachers would need to reconnect).
# TOKEN_ENCRYPTION_KEY=

# Plain SMTP (src/lib/email/send-email.ts) — works with any provider that speaks SMTP
# (Яндекс, Mail.ru, Gmail, a self-hosted server, ...), not tied to one vendor. Until all four
# of HOST/PORT/USER/PASSWORD are set, password-reset and email-verification links are logged
# on the server instead of emailed — a deliberate dev-mode fallback (docs/AUTH.md §3, §6), not
# a silent failure. SMTP_FROM defaults to SMTP_USER if omitted. SMTP_SECURE overrides the
# default (secure only on port 465) for a provider that needs it forced either way.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# SMTP_SECURE=

# Only needed once file storage (docs/FILE_STORAGE.md) is built — not required for Phase 1.
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# Authorizes POST /api/internal/cron/auth-cleanup (docs/DATABASE.md §7, docs/API.md §5) —
# the system cron calls that endpoint with this as a Bearer token. Generate with
# `openssl rand -base64 32`. Also protects the whiteboard retention cron once that exists
# (Phase 3, docs/WHITEBOARD.md §5) — same secret, same auth pattern.
INTERNAL_CRON_SECRET=

# Only needed once the realtime whiteboard service (docs/WHITEBOARD.md) is built — Phase 3.
# REALTIME_WS_URL=

# Absolute path to the local-disk stand-in for the whiteboard snapshot bucket
# (docs/FILE_STORAGE.md §2/§3, docs/WHITEBOARD.md §4) — MUST be the exact same absolute path
# as app/realtime's own WHITEBOARD_SNAPSHOT_DIR (see that package's .env.example): app/web only
# ever DELETES snapshot objects (retention cron), app/realtime only ever writes/reads them, and
# in this temporary local-disk phase that only works if both processes agree on one physical
# directory. A real S3 bucket would have no such constraint (docs/WHITEBOARD.md §4).
# WHITEBOARD_SNAPSHOT_DIR=
