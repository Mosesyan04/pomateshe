// Pomateshe — Prisma schema.
// Mirrors docs/DATABASE.md exactly; see that document for the rationale behind each
// entity and field. Do not let this file and docs/DATABASE.md drift apart — update both
// together.
//
// Row-Level Security policies, FORCE ROW LEVEL SECURITY, and GRANTs are NOT expressed here
// (Prisma's schema DSL has no first-party RLS support) — they live in raw SQL appended to
// the initial migration. See docs/MULTI_TENANCY.md §2.3 for why this is not optional.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  admin
  teacher
  student
}

enum LessonStatus {
  scheduled
  completed
  cancelled
  no_show
}

enum LinkStatus {
  active
  archived
}

enum ConsentType {
  privacy_policy
  pdn_processing
  cookie_analytics
  cookie_marketing
  offer
}

enum InviteStatus {
  pending
  accepted
  revoked
}

/// Base identity table. Custom auth (docs/AUTH.md §0) — not managed by an external auth framework.
model User {
  id             String    @id @default(cuid(2))
  email          String    @unique
  emailVerifiedAt DateTime?
  passwordHash   String
  role           UserRole
  createdAt      DateTime  @default(now())
  disabledAt     DateTime?

  /// Denormalized pointer to TeacherProfile.id, set once at registration, for role=teacher
  /// users only. Exists ONLY to break a chicken-and-egg problem: teacher_profiles' RLS
  /// policy is keyed on its own id (docs/MULTI_TENANCY.md §2.3), so "given a userId, find
  /// their teacherId" cannot be answered by querying teacher_profiles at all — there's no
  /// context to set yet, since finding that context IS the query. Found the hard way in
  /// Phase 1: src/lib/auth/current-user.ts's getCurrentUser() queried teacherProfile by
  /// userId directly and silently got zero rows on every single request post-login (RLS
  /// failing closed exactly as designed, just against a legitimate query). Storing the
  /// pointer here works because User carries no RLS at all — deliberately not a `@relation`
  /// to keep this a plain, manually-managed value, not something Prisma treats as a live
  /// join target.
  teacherProfileId String? @unique

  teacherProfile      TeacherProfile?
  studentLinks        TeacherStudentLink[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  consentRecords      ConsentRecord[]
  auditLogEntries     AuditLog[]

  @@map("users")
}

/// Not tenant-scoped — belongs to the platform, not a teacher. No RLS.
model Session {
  id         String   @id @default(cuid(2))
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// Not tenant-scoped. No RLS.
model PasswordResetToken {
  id        String    @id @default(cuid(2))
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

/// Has a second RLS policy beyond the standard owner-scoped one — `public_read` (added in the
/// 20260910170000 migration) permits SELECT with no tenant context at all, since /t/[slug]
/// (docs/MULTI_TENANCY.md §4.3) must be readable by an anonymous visitor. bio/subjects/
/// avatarStorageKey/avatarMimeType/displayName/slug/defaultLessonPriceCents/currency are the
/// columns actually intended to be public (see src/server/teacher-profile.ts's
/// getPublicTeacherProfile) — zoomPersonalLink and publicPageSettings are NOT, even though
/// the public_read policy itself does not distinguish columns (RLS is row-level).
model TeacherProfile {
  id                      String   @id @default(cuid(2))
  userId                  String   @unique
  slug                    String   @unique
  displayName             String
  bio                     String?
  subjects                String[]
  avatarStorageKey        String?
  avatarMimeType          String?
  /// Free text, shown on the public page (/t/[slug]) — how a prospective student reaches the
  /// teacher. Not a signup flow: registration stays invite-only (docs/AUTH.md §3).
  contactInfo             String?
  timezone                String
  publicPageSettings      Json     @default("{}")
  zoomPersonalLink        String?
  defaultLessonPriceCents Int?
  currency                String   @default("RUB")
  createdAt               DateTime @default(now())

  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  studentLinks        TeacherStudentLink[]
  studentInvites      StudentInvite[]
  groups              Group[]
  groupMembers        GroupMember[]
  lessons             Lesson[]
  homework            Homework[]
  materialFiles       MaterialFile[]
  whiteboards         Whiteboard[]
  calendarIntegration CalendarIntegration?

  @@map("teacher_profiles")
}

/// Many-to-many between User(role=student) and TeacherProfile. See docs/MULTI_TENANCY.md §1.1, §3.2 —
/// the only table with two RLS policies (teacher_scope OR student_scope).
model TeacherStudentLink {
  id                     String     @id @default(cuid(2))
  teacherId              String
  studentUserId          String
  displayName            String?
  contactPhone           String?
  contactTelegram        String?
  /// Free text, not an enum — subjects vary per teacher (docs/DATABASE.md doesn't fix a
  /// closed list), the /teacher/students filter matches against whatever teachers have
  /// actually typed for their own students, not a global taxonomy.
  subject                String?
  gradeLevel             String?
  /// Defaults pre-filled into the "new lesson" form (src/app/teacher/schedule) — NOT enforced
  /// anywhere; a teacher can still set a different price/duration per individual lesson.
  defaultPriceCents      Int?
  defaultDurationMinutes Int?
  notes                  String?
  status                 LinkStatus @default(active)
  invitedAt              DateTime   @default(now())
  joinedAt               DateTime?
  createdAt              DateTime   @default(now())

  teacher     TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  studentUser User           @relation(fields: [studentUserId], references: [id], onDelete: Cascade)

  groupMembers GroupMember[]
  lessons      Lesson[]
  homework     Homework[]

  @@unique([teacherId, studentUserId])
  @@index([teacherId])
  @@index([studentUserId])
  @@map("teacher_student_links")
}

/// Not in the original docs/DATABASE.md draft — added while building the invite flow
/// (docs/AUTH.md §3). Deliberately NOT RLS-protected, same reasoning as
/// PasswordResetToken/Session (docs/DATABASE.md §2): the row that matters is looked up by an
/// unguessable token hash by someone who isn't authenticated as the teacher yet — that IS
/// the authorization, the same way a password-reset link is. RLS would only get in the way
/// of that lookup (fail-closed with no tenant context set) without adding real protection,
/// since the token itself is already the secret. Teacher-facing list/revoke operations
/// still filter by teacherId explicitly in the data-access layer (src/server/invites.ts),
/// same pattern as Session/PasswordResetToken already use.
model StudentInvite {
  id         String       @id @default(cuid(2))
  teacherId  String
  email      String
  tokenHash  String       @unique
  status     InviteStatus @default(pending)
  expiresAt  DateTime
  createdAt  DateTime     @default(now())
  acceptedAt DateTime?

  teacher TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId])
  @@map("student_invites")
}

model Group {
  id         String    @id @default(cuid(2))
  teacherId  String
  name       String
  createdAt  DateTime  @default(now())
  archivedAt DateTime?

  teacher TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  members GroupMember[]
  lessons Lesson[]

  @@index([teacherId])
  @@map("groups")
}

/// teacherId is denormalized here (also derivable via groupId -> Group.teacherId) so this
/// table follows the same "every tenant table carries teacherId directly" rule as the rest
/// of the schema (docs/DATABASE.md §1) — RLS policies stay uniform (direct column compare,
/// no subquery) instead of this one table needing a different, slower policy shape. The
/// data-access layer sets it from the parent Group at creation, never from client input.
model GroupMember {
  id            String    @id @default(cuid(2))
  teacherId     String
  groupId       String
  studentLinkId String
  joinedAt      DateTime  @default(now())
  leftAt        DateTime?

  teacher     TeacherProfile     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  group       Group              @relation(fields: [groupId], references: [id], onDelete: Cascade)
  studentLink TeacherStudentLink @relation(fields: [studentLinkId], references: [id], onDelete: Cascade)

  @@unique([groupId, studentLinkId])
  @@index([teacherId])
  @@map("group_members")
}

model Lesson {
  id               String       @id @default(cuid(2))
  teacherId        String
  studentLinkId    String?
  groupId          String?
  scheduledAt      DateTime
  durationMinutes  Int
  status           LessonStatus @default(scheduled)
  priceCents       Int
  currency         String       @default("RUB")
  paidAt           DateTime?
  zoomLinkSnapshot String?
  calendarEventId  String?
  notes            String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  deletedAt        DateTime?

  teacher       TeacherProfile      @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  studentLink   TeacherStudentLink? @relation(fields: [studentLinkId], references: [id])
  group         Group?              @relation(fields: [groupId], references: [id])
  homework      Homework[]
  materialFiles MaterialFile[]
  whiteboard  Whiteboard?

  @@index([teacherId, scheduledAt])
  @@index([teacherId, paidAt])
  @@map("lessons")
  // CHECK (exactly one of studentLinkId/groupId set) — added in raw SQL migration,
  // Prisma schema DSL has no CHECK constraint support at this Prisma version for this shape.
}

model Homework {
  id            String    @id @default(cuid(2))
  teacherId     String
  lessonId      String?
  studentLinkId String?
  groupId       String?
  title         String
  description   String?
  dueAt         DateTime?
  createdAt     DateTime  @default(now())

  teacher     TeacherProfile      @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  lesson      Lesson?             @relation(fields: [lessonId], references: [id])
  studentLink TeacherStudentLink? @relation(fields: [studentLinkId], references: [id])
  materialFiles MaterialFile[]

  @@index([teacherId, dueAt])
  @@map("homework")
}

/// No deletedAt — hard delete, see docs/DATABASE.md §1 (review-2: resolved soft/hard-delete
/// inconsistency in favor of the simpler model).
model MaterialFile {
  id               String   @id @default(cuid(2))
  teacherId        String
  ownerUserId      String
  homeworkId       String?
  lessonId         String?
  storageKey       String
  originalFileName String
  mimeType         String
  sizeBytes        Int
  createdAt        DateTime @default(now())

  teacher  TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  homework Homework?      @relation(fields: [homeworkId], references: [id])
  lesson   Lesson?        @relation(fields: [lessonId], references: [id])

  @@index([teacherId])
  @@index([homeworkId])
  @@index([lessonId])
  @@map("material_files")
}

/// FK lives here only (not also on Lesson) — see docs/DATABASE.md §1 (review-2: resolved the
/// redundant bidirectional Lesson<->Whiteboard link from the first draft).
model Whiteboard {
  id                 String    @id @default(cuid(2))
  teacherId          String
  lessonId           String    @unique
  snapshotStorageKey String?
  lastActivityAt     DateTime  @default(now())
  expiresAt          DateTime
  createdAt          DateTime  @default(now())

  teacher TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  lesson  Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([teacherId])
  @@index([expiresAt])
  @@map("whiteboards")
}

model CalendarIntegration {
  id                    String    @id @default(cuid(2))
  teacherId             String    @unique
  provider              String    @default("google")
  googleAccountEmail    String?
  accessTokenEncrypted  String?
  refreshTokenEncrypted String?
  tokenExpiresAt        DateTime?
  calendarId            String?
  watchChannelId        String?   @unique
  watchExpiresAt        DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  teacher TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@map("calendar_integrations")
}

/// Survives account deletion (obfuscated, not deleted) — see docs/CONSENTS.md §4, docs/DATABASE.md §7.
model ConsentRecord {
  id            String      @id @default(cuid(2))
  userId        String
  type          ConsentType
  policyVersion String
  acceptedAt    DateTime    @default(now())
  ip            String?
  userAgent     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, policyVersion])
  @@index([userId, type])
  @@map("consent_records")
}

/// Survives actor deletion — see docs/DATABASE.md §2, §7.
model AuditLog {
  id         String   @id @default(cuid(2))
  actorUserId String?
  action     String
  targetType String
  targetId   String
  metadata   Json     @default("{}")
  ip         String?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}
